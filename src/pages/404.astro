---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="terminal" style="align-items: center; justify-content: center; text-align: center;">
    <div class="terminal-line terminal-line--system" style="font-size: 48px; margin-bottom: 16px;">
      404
    </div>
    <div class="terminal-line terminal-line--error crt-glow-strong" style="font-size: 18px; margin-bottom: 24px;">
      command not found: this page
    </div>
    <div class="terminal-line terminal-line--info" style="margin-bottom: 32px;">
      The page you're looking for doesn't exist or has been moved.
    </div>
    <div class="terminal-line">
      <a href="/portfolio/" class="terminal-link crt-glow" style="font-size: 16px;">
        cd ~ &amp;&amp; start-over
      </a>
    </div>
  </div>
  <div class="gui-wrapper" style="align-items: center; justify-content: center; text-align: center; display: flex;">
    <div style="padding: 64px 24px;">
      <h1 style="font-size: 3rem; font-weight: 700; color: var(--gui-text); margin: 0 0 8px;">404</h1>
      <p style="font-size: 1.1rem; color: var(--gui-text-secondary); margin: 0 0 24px;">Page not found</p>
      <a href="/portfolio/" class="gui-cta gui-cta--primary">Go Home</a>
    </div>
  </div>
</BaseLayout>
