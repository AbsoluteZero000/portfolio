---
import '../styles/global.css';
import '../styles/simple.css';
---

<!doctype html>
<html lang="en" data-theme="green" data-mode="simple">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Ahmed Wanas is a backend software engineer building scalable APIs, distributed systems, and cloud-native products." />
    <meta name="theme-color" content="#101b18" />
    <link rel="icon" type="image/svg+xml" href="/portfolio/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Ahmed Wanas — Backend Software Engineer</title>
  </head>
  <body>
    <slot />
    <div class="crt-overlay"></div>
    <script>
      (function() {
        var html = document.documentElement;

        var mode = localStorage.getItem('portfolio-mode');
        if (mode === 'terminal' || mode === 'simple') {
          html.setAttribute('data-mode', mode);
        }

        var simpleTheme = localStorage.getItem('portfolio-simple-theme');
        if (simpleTheme === 'dark' || simpleTheme === 'light') {
          html.setAttribute('data-simple-theme', simpleTheme);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          html.setAttribute('data-simple-theme', 'dark');
        }

        function toggleMode() {
          var current = html.getAttribute('data-mode') || 'simple';
          var next = current === 'simple' ? 'terminal' : 'simple';
          html.setAttribute('data-mode', next);
          localStorage.setItem('portfolio-mode', next);
        }

        function toggleSimpleTheme() {
          var current = html.getAttribute('data-simple-theme') || 'light';
          var next = current === 'light' ? 'dark' : 'light';
          html.setAttribute('data-simple-theme', next);
          localStorage.setItem('portfolio-simple-theme', next);
          var btn = document.getElementById('simple-theme-toggle');
          if (btn) btn.textContent = next === 'dark' ? '\u2600' : '\u263E';
        }

        document.querySelectorAll('.mode-toggle-btn').forEach(function(btn) {
          btn.addEventListener('click', toggleMode);
        });

        var simpleThemeToggle = document.getElementById('simple-theme-toggle');
        if (simpleThemeToggle) {
          simpleThemeToggle.addEventListener('click', toggleSimpleTheme);
          var currentTheme = html.getAttribute('data-simple-theme') || 'light';
          simpleThemeToggle.textContent = currentTheme === 'dark' ? '\u2600' : '\u263E';
        }
      })();
    </script>
  </body>
</html>
