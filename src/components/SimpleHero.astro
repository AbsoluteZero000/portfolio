---
import { PORTFOLIO } from '../lib/portfolio';
---

<section class="gui-hero" id="top">
  <div class="gui-hero-content">
    <div class="availability"><span></span> Available for ambitious backend work</div>
    <p class="gui-hero-eyebrow">Hello, I’m Ahmed — a backend engineer in Giza.</p>
    <h1>I build the systems<br />behind <em>great products.</em></h1>
    <p class="gui-hero-tagline">{PORTFOLIO.summary}</p>
    <div class="gui-hero-ctas">
      <a href="#projects" class="gui-cta gui-cta--primary">Explore my work <span>↗</span></a>
      <a href={PORTFOLIO.resume} class="gui-cta gui-cta--secondary" target="_blank" rel="noopener noreferrer">Résumé <span>↓</span></a>
    </div>
    <div class="gui-social">
      <span>Find me on</span>
      <a href={PORTFOLIO.social.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a href={PORTFOLIO.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      <a href={`mailto:${PORTFOLIO.email}`}>Email ↗</a>
    </div>
  </div>
  <div class="gui-hero-visual" aria-hidden="true">
    <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
    <div class="gui-hero-terminal">
      <div class="terminal-bar"><div class="gui-hero-terminal-dots"><span></span><span></span><span></span></div><span>ahmed@portfolio ~</span></div>
      <div class="terminal-body">
        <div><span class="gui-hero-prompt">❯</span> <span class="gui-hero-cmd">cat profile.json</span></div>
        <div class="code-block"><span>{`{`}</span><br />&nbsp;&nbsp;<b>"role"</b>: <i>"Backend Engineer"</i>,<br />&nbsp;&nbsp;<b>"focus"</b>: [<i>"APIs"</i>, <i>"Distributed Systems"</i>],<br />&nbsp;&nbsp;<b>"stack"</b>: [<i>"Java"</i>, <i>"Go"</i>, <i>"Python"</i>],<br />&nbsp;&nbsp;<b>"status"</b>: <i>"building"</i><br /><span>{`}`}</span></div>
        <div class="terminal-success">✓ All systems operational</div>
        <div><span class="gui-hero-prompt">❯</span> <span class="cursor"></span></div>
      </div>
    </div>
  </div>
</section>
