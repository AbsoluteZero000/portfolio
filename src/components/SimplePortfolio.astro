---
import SimpleHero from './SimpleHero.astro';
import SimpleSkills from './SimpleSkills.astro';
import SimpleExperience from './SimpleExperience.astro';
import SimpleProjects from './SimpleProjects.astro';
import SimpleContact from './SimpleContact.astro';
import ModeToggle from './ModeToggle.astro';
import { PORTFOLIO } from '../lib/portfolio';
---

<div class="gui-wrapper">
  <nav class="gui-nav">
    <a class="gui-nav-brand" href="#top" aria-label="Back to top">
      <span class="brand-mark">AW</span>
      <span class="brand-copy">Ahmed Wanas<small>Backend engineer</small></span>
    </a>
    <div class="gui-nav-links">
      <a href="#experience">Experience</a>
      <a href="#projects">Work</a>
      <a href="#skills">Toolkit</a>
      <a href="#contact">Contact</a>
      <button class="simple-theme-toggle" id="simple-theme-toggle" title="Toggle color theme" aria-label="Toggle color theme">☾</button>
      <ModeToggle />
    </div>
  </nav>

  <div class="gui-container">
    <SimpleHero />
    <SimpleSkills />
    <SimpleExperience />
    <SimpleProjects />
    <SimpleContact />
  </div>
</div>
