---
import ThemeSwitcher from './ThemeSwitcher.astro';
import ModeToggle from './ModeToggle.astro';
import CommandNav from './CommandNav.astro';
---

<div class="terminal">
  <div class="terminal-titlebar">
    <div class="terminal-dots">
      <span class="terminal-dot terminal-dot--close"></span>
      <span class="terminal-dot terminal-dot--minimize"></span>
      <span class="terminal-dot terminal-dot--maximize"></span>
    </div>
    <span class="terminal-title">ahmed@portfolio — bash — 80×24</span>
  </div>

  <CommandNav />

  <div class="terminal-body">
    <div class="terminal-output" id="terminal-output" role="log" aria-live="polite">
      <div class="terminal-line terminal-line--system">Last login: Sun May 10 2026 from visiting-portfolio</div>
      <div class="terminal-line terminal-line--raw"></div>
      <div class="terminal-line terminal-line--raw">
        <span class="crt-glow-strong" style="font-size: 1.4rem; font-weight: 700; color: var(--fg-bright);">Ahmed Wanas</span>
      </div>
      <div class="terminal-line terminal-line--raw">
        <span style="color: var(--accent);">Backend Software Engineer</span>
        <span style="color: var(--fg-dim);"> · </span>
        <span class="crt-glow" style="color: var(--accent);">Linux enthusiast</span>
        <span style="color: var(--fg-dim);"> · </span>
        <span style="color: var(--fg);">Java, Go, Python, Distributed Systems</span>
      </div>
      <div class="terminal-line terminal-line--raw" style="margin: 2px 0;">
        <span style="color: var(--fg-dim);">Giza, Egypt</span>
        <span style="color: var(--fg-dim);">  |  </span>
        <a href="mailto:ahmedwaelwanas@gmail.com" class="terminal-link">ahmedwaelwanas@gmail.com</a>
      </div>
      <div class="terminal-line terminal-line--raw" style="margin: 2px 0 0 0;">
        <a href="https://github.com/AbsoluteZero000" class="terminal-link" target="_blank">GitHub</a>
        <span style="color: var(--fg-dim);"> | </span>
        <a href="https://www.linkedin.com/in/ahmedwaelwanas" class="terminal-link" target="_blank">LinkedIn</a>
        <span style="color: var(--fg-dim);"> | </span>
        <a href="https://leetcode.com/u/ahmedwaelwanas/" class="terminal-link" target="_blank">LeetCode</a>
      </div>
      <div class="terminal-line terminal-line--raw"></div>
      <div class="terminal-line terminal-line--separator" style="color: var(--fg-dim);">
        ────────────────────────────────────────────────────────────────
      </div>
      <div class="terminal-line terminal-line--raw"></div>
      <div class="terminal-line terminal-line--info">
        <span style="font-size: 1.1rem;">
          <span class="crt-glow-strong">❯</span>
          <strong><span class="terminal-link crt-glow-strong" data-cmd="ls projects/" style="color: var(--accent); font-size: 1.1rem;">projects/</span></strong>
          <span style="color: var(--fg-dim);">  ·  </span>
          <strong><span class="terminal-link crt-glow-strong" data-cmd="ls experience/" style="color: var(--accent); font-size: 1.1rem;">experience/</span></strong>
          <span style="color: var(--fg-dim);">  ·  </span>
          <strong><span class="terminal-link crt-glow-strong" data-cmd="cat skills" style="color: var(--accent); font-size: 1.1rem;">skills</span></strong>
        </span>
      </div>
      <div class="terminal-line terminal-line--info" style="margin-top: 4px;">
        <span style="color: var(--fg-dim);">Type <span class="terminal-link" data-cmd="help">help</span> for all commands  ·  Press <span class="crt-glow">T</span> to cycle themes</span>
      </div>
      <div class="terminal-line terminal-line--raw"></div>
    </div>

    <div class="terminal-input-container">
      <span class="terminal-prompt crt-glow">ahmed@portfolio:~$</span>
      <span class="terminal-cursor cursor-blink"></span>
      <input
        type="text"
        class="terminal-input"
        id="terminal-input"
        placeholder="type a command..."
        autofocus
        spellcheck="false"
        autocomplete="off"
      />
    </div>
  </div>

  <div class="terminal-statusbar">
    <span>
      <span id="clock"></span>
    </span>
    <div class="terminal-statusbar-right">
      <span class="terminal-statusbar-button" id="github-btn" title="Open GitHub">
        GitHub
      </span>
      <span class="terminal-statusbar-button" id="linkedin-btn" title="Open LinkedIn">
        LinkedIn
      </span>
      <ThemeSwitcher />
      <ModeToggle />
    </div>
  </div>
</div>

<script>
  import { initTerminal, updateThemeIndicator } from '../lib/interactive';

  const output = document.getElementById('terminal-output')!;
  const input = document.getElementById('terminal-input') as HTMLInputElement;

  initTerminal(output, input);

  document.getElementById('github-btn')!.addEventListener('click', () => {
    window.open('https://github.com/AbsoluteZero000', '_blank');
  });

  document.getElementById('linkedin-btn')!.addEventListener('click', () => {
    window.open('https://www.linkedin.com/in/ahmedwaelwanas', '_blank');
  });

  function updateClock() {
    const now = new Date();
    const time = now.toLocaleTimeString('en-US', { hour12: false });
    const clock = document.getElementById('clock');
    if (clock) clock.textContent = time;
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>
