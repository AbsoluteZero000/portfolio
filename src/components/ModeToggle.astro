<span class="mode-toggle-terminal">
  <button class="terminal-statusbar-button mode-toggle-btn" title="Switch to Simple Mode">
    Simple Mode
  </button>
</span>
<span class="mode-toggle-simple">
  <button class="simple-mode-toggle mode-toggle-btn" title="Switch to Terminal Mode">
    Terminal Mode
  </button>
</span>

<style is:global>
  [data-mode="terminal"] .mode-toggle-simple { display: none !important; }
  [data-mode="simple"] .mode-toggle-terminal { display: none !important; }

  .simple-mode-toggle {
    background: transparent;
    border: 1px solid var(--gui-border-strong);
    color: var(--gui-text);
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 8px 13px;
    border-radius: 99px;
    cursor: pointer;
    transition: border-color 0.15s, color .15s;
  }

  .simple-mode-toggle:hover {
    border-color: var(--gui-accent);
    color: var(--gui-accent);
  }

  @media (max-width: 420px) {
    .simple-mode-toggle { font-size: 10px; padding: 7px 9px; }
  }
</style>
