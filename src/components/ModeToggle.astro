<span class="mode-toggle-terminal">
  <button class="terminal-statusbar-button mode-toggle-btn" title="Switch to Simple Mode">
    Simple Mode
  </button>
</span>
<span class="mode-toggle-simple">
  <button class="simple-mode-toggle mode-toggle-btn" title="Switch to Terminal Mode">
    Terminal Mode
  </button>
</span>

<style is:global>
  [data-mode="terminal"] .mode-toggle-simple { display: none !important; }
  [data-mode="simple"] .mode-toggle-terminal { display: none !important; }

  .simple-mode-toggle {
    background: #f5f5f4;
    border: 1px solid #d6d3d1;
    color: #44403c;
    font-family: "JetBrains Mono", monospace;
    font-size: 12px;
    padding: 4px 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 0.15s;
  }

  .simple-mode-toggle:hover {
    background: #e7e5e4;
  }
</style>
