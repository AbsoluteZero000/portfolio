---
import { PORTFOLIO, highlightTech } from '../lib/portfolio';
---

<section class="gui-section" id="projects">
  <h2 class="gui-section-title">projects</h2>
  <div class="gui-projects-grid">
    {PORTFOLIO.projects.map(p => (
      <div class="gui-project-card">
        <h3 class="gui-project-title">{p.title}</h3>
        <div class="gui-project-stack">{p.stack}</div>
        <p class="gui-project-desc" set:html={highlightTech(p.description)}></p>
        {p.github && <a href={p.github} class="gui-project-link" target="_blank" rel="noopener noreferrer">View on GitHub →</a>}
      </div>
    ))}
  </div>
</section>
